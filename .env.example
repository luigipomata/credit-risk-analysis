# Copia questo file in ".env" e imposta i valori per la tua macchina.
# ".env" non va MAI versionato (è già escluso in .gitignore).

# Nome server\istanza SQL Server (es. NOMEPC\SQLEXPRESS oppure localhost)
DB_SERVER=NOMEPC\SQLEXPRESS

# Database applicativo del progetto
DB_DATABASE=CreditRiskAnalysis

# Driver ODBC installato sulla macchina (vedi: pyodbc.drivers())
DB_DRIVER=ODBC Driver 17 for SQL Server

# Autenticazione di Windows (Trusted Connection). Se in futuro serve
# l'autenticazione SQL, aggiungere DB_USER e DB_PASSWORD e adattare
# sql/db_connection.py di conseguenza.
DB_TRUSTED_CONNECTION=yes

# Necessario in locale con driver 18+ per evitare errori di certificato SSL
# su istanze SQL Server non configurate con un certificato firmato.
DB_TRUST_SERVER_CERTIFICATE=yes
